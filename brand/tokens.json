{
  "$schema_version": 1,
  "$comment": "RustStand brand tokens. Source: RustPep ui/styles.css @ 0abea99 (v0.39.0); RustCore ui/styles.css is byte-identical. Success colours from RustCore ui/rustcore.css. State colours and the sunlight theme are new for RustStand (proposed, awaiting Geoff's confirmation). Edit this file, then run `node brand/build.mjs` to regenerate tokens.css.",
  "brand": {
    "night": "#0F1B2D",
    "ignition": "#F2551B",
    "white": "#FFFFFF",
    "haze": "#9FB0C8"
  },
  "font": {
    "ui": "\"Segoe UI Variable Text\", \"Segoe UI\", -apple-system, BlinkMacSystemFont, system-ui, \"Ubuntu\", \"Cantarell\", \"Noto Sans\", \"DejaVu Sans\", \"Helvetica Neue\", Arial, sans-serif",
    "mono": "\"Cascadia Mono\", Consolas, ui-monospace, \"SF Mono\", Menlo, Monaco, \"DejaVu Sans Mono\", \"Liberation Mono\", \"Noto Sans Mono\", monospace",
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "heavy": 800 },
    "lineHeight": 1.45
  },
  "size": {
    "$comment": "px. Base 14 matches RustPep on desktop; readouts are RustStand's large live numbers.",
    "xs": 11,
    "sm": 12,
    "md": 14,
    "lg": 17,
    "xl": 20,
    "xxl": 24,
    "readout": 44,
    "readoutLg": 64
  },
  "radius": { "xs": 2, "sm": 4, "control": 6, "tile": 8, "card": 10, "dialog": 12 },
  "space": { "1": 2, "2": 4, "3": 6, "4": 8, "5": 12, "6": 16, "7": 24, "8": 32 },
  "touchMin": 44,
  "shadow": {
    "tooltip": "0 4px 14px rgba(0,0,0,.18)",
    "menu": "0 8px 24px rgba(0,0,0,.18)",
    "drawer": "0 8px 30px rgba(0,0,0,.3)"
  },
  "logo": {
    "mark": "brand/assets/logo.png",
    "appIcon": "brand/assets/app-icon.png",
    "appIcon1024": "brand/assets/app-icon-1024.png",
    "vector": "../rustpep/RocketSalvo Logo.pdf",
    "wordmark": "ROCKET + SALVO (SALVO in ignition), weight 800, letter-spacing .04em"
  },
  "themes": {
    "standard": {
      "$comment": "RustPep light theme.",
      "fontScale": 1,
      "borderWidth": 1,
      "color": {
        "background": "#F3F4F6",
        "surface": "#FFFFFF",
        "hover": "#EEF1F6",
        "text": "#0F1B2D",
        "textMuted": "#5B6B82",
        "border": "#D8DDE6",
        "accent": "#F2551B",
        "accentHover": "#FF6A33",
        "onAccent": "#0F1B2D",
        "accentText": "#C4400E",
        "headerBackground": "#0F1B2D",
        "headerText": "#FFFFFF",
        "headerMuted": "#9FB0C8",
        "headerHover": "#1B2942",
        "dangerBackground": "#FDECEC",
        "dangerText": "#A12020",
        "warningBackground": "#FFF6E0",
        "warningText": "#7A5200",
        "successBackground": "#E7F5EE",
        "successText": "#23875A",
        "chartGrid": "#E6E8EE",
        "focus": "#F2551B"
      },
      "series": ["#2A78D6", "#EB6834", "#23875A", "#8250C4"],
      "state": {
        "disconnected": { "bg": "#5B6B82", "on": "#FFFFFF" },
        "idle": { "bg": "#1F7A51", "on": "#FFFFFF" },
        "armed": { "bg": "#E8A317", "on": "#0F1B2D" },
        "recording": { "bg": "#D92D20", "on": "#FFFFFF" },
        "processing": { "bg": "#2368C0", "on": "#FFFFFF" },
        "done": { "bg": "#1FA88F", "on": "#0F1B2D" },
        "error": { "bg": "#6D28D9", "on": "#FFFFFF" }
      }
    },
    "dark": {
      "$comment": "RustPep dark theme (RustPep follows the OS setting).",
      "fontScale": 1,
      "borderWidth": 1,
      "color": {
        "background": "#0A1220",
        "surface": "#14213A",
        "hover": "#1C2B47",
        "text": "#E9EDF5",
        "textMuted": "#94A3BB",
        "border": "#273652",
        "accent": "#F2551B",
        "accentHover": "#FF6A33",
        "onAccent": "#0F1B2D",
        "accentText": "#FF7D4A",
        "headerBackground": "#16243D",
        "headerText": "#FFFFFF",
        "headerMuted": "#9FB0C8",
        "headerHover": "#22345A",
        "dangerBackground": "#3A1D1D",
        "dangerText": "#FFB3B3",
        "warningBackground": "#3A3018",
        "warningText": "#FFD98A",
        "successBackground": "#173226",
        "successText": "#3FAE7B",
        "chartGrid": "#22304A",
        "focus": "#FF6A33"
      },
      "series": ["#3987E5", "#D95926", "#3FAE7B", "#A47BE0"],
      "state": {
        "disconnected": { "bg": "#3A4A5E", "on": "#FFFFFF" },
        "idle": { "bg": "#3FAE7B", "on": "#0A1220" },
        "armed": { "bg": "#F2B33D", "on": "#0A1220" },
        "recording": { "bg": "#F04438", "on": "#0A1220" },
        "processing": { "bg": "#3987E5", "on": "#0A1220" },
        "done": { "bg": "#2CC4A7", "on": "#0A1220" },
        "error": { "bg": "#A78BFA", "on": "#0A1220" }
      }
    },
    "sunlight": {
      "$comment": "High-contrast theme for direct sun: pure white/black, ≥7:1 text contrast, thicker borders, 15% larger type. New for RustStand.",
      "fontScale": 1.15,
      "borderWidth": 2,
      "color": {
        "background": "#FFFFFF",
        "surface": "#FFFFFF",
        "hover": "#E5E7EB",
        "text": "#000000",
        "textMuted": "#1F2937",
        "border": "#000000",
        "accent": "#F2551B",
        "accentHover": "#D9480F",
        "onAccent": "#000000",
        "accentText": "#9A2E05",
        "headerBackground": "#000000",
        "headerText": "#FFFFFF",
        "headerMuted": "#E5E7EB",
        "headerHover": "#1F2937",
        "dangerBackground": "#FFFFFF",
        "dangerText": "#8B0000",
        "warningBackground": "#FFFFFF",
        "warningText": "#5C3D00",
        "successBackground": "#FFFFFF",
        "successText": "#0B5D33",
        "chartGrid": "#9CA3AF",
        "focus": "#000000"
      },
      "series": ["#0047AB", "#C2410C", "#0B5D33", "#5B21B6"],
      "state": {
        "disconnected": { "bg": "#374151", "on": "#FFFFFF" },
        "idle": { "bg": "#0B5D33", "on": "#FFFFFF" },
        "armed": { "bg": "#FFC800", "on": "#000000" },
        "recording": { "bg": "#991B1B", "on": "#FFFFFF" },
        "processing": { "bg": "#0047AB", "on": "#FFFFFF" },
        "done": { "bg": "#005A4F", "on": "#FFFFFF" },
        "error": { "bg": "#4C1D95", "on": "#FFFFFF" }
      }
    }
  }
}
